# Copy this file to `.env` (which is git-ignored) and fill in the values.
# docker-compose.advanced.yml reads it automatically.

# Optional. A GitHub fine-grained personal access token with "Public
# repositories" read-only access. Raises the API rate limit from 60 to
# 5000 requests per hour. Leave empty to run unauthenticated.
GITHUB_TOKEN=

# Timezone used for the timestamps rendered by the backend.
TZ=Asia/Shanghai
